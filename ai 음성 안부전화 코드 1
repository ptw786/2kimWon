<!doctype html>
<html lang="ko">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
        <title>안심온 AI 안부전화</title>
        <style>
            :root {
                font-family: system-ui,-apple-system,'Noto Sans KR',sans-serif;
                color: #14233a;
                background: #edf3fa
            }

            * {
                box-sizing: border-box
            }

            body {
                margin: 0
            }

            button {
                cursor: pointer;
                font: inherit
            }

            button:disabled {
                opacity: .45;
                cursor: not-allowed
            }

            .shell {
                max-width: 1100px;
                margin: auto;
                padding: 26px 20px 70px
            }

            .top {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 10px;
                margin-bottom: 25px
            }

            .brand {
                font-size: 23px;
                font-weight: 850;
                letter-spacing: -1px
            }

            .brand span {
                color: #2d73df
            }

            .tag {
                font-size: 12px;
                color: #56708f;
                background: white;
                padding: 9px 13px;
                border-radius: 99px
            }

            .hero h1 {
                font-size: clamp(27px,4vw,42px);
                letter-spacing: -1.8px;
                margin: 0 0 10px
            }

            .hero p {
                color: #65758b;
                line-height: 1.7;
                margin: 0 0 24px
            }

            .layout {
                display: grid;
                grid-template-columns: minmax(300px,390px) 1fr;
                gap: 24px;
                align-items: start
            }

            .phone {
                min-height: 625px;
                background: linear-gradient(150deg,#172e51,#081427 72%);
                border: 8px solid #1e2c40;
                border-radius: 43px;
                box-shadow: 0 24px 65px #1b3e6b33;
                color: white;
                padding: 22px;
                display: flex;
                flex-direction: column;
                align-items: center;
                text-align: center;
                position: relative;
                overflow: hidden
            }

            .phone:before {
                content: '';
                width: 105px;
                height: 22px;
                background: #020914;
                border-radius: 0 0 18px 18px;
                position: absolute;
                top: 0
            }

            .status {
                align-self: stretch;
                text-align: left;
                font-size: 13px;
                opacity: .75
            }

            .callinfo {
                margin-top: 95px
            }

            .small {
                color: #a8c5ef;
                font-size: 15px
            }

            .caller {
                font-size: 35px;
                font-weight: 750;
                margin: 13px 0
            }

            .sub {
                color: #b2c6de;
                font-size: 14px
            }

            .avatar {
                width: 95px;
                height: 95px;
                background: #ffffff16;
                border-radius: 50%;
                display: grid;
                place-items: center;
                font-size: 44px;
                margin: 30px auto
            }

            .actions {
                margin-top: auto;
                width: 100%;
                display: flex;
                justify-content: space-evenly;
                gap: 15px;
                padding-bottom: 40px
            }

            .circle {
                width: 72px;
                height: 72px;
                border-radius: 50%;
                border: 0;
                color: white;
                font-size: 29px;
                display: grid;
                place-items: center
            }

            .green {
                background: #20ba76
            }

            .red {
                background: #f24c62
            }

            .actionlabel {
                font-size: 13px;
                margin-top: 8px;
                color: #d5e0ef
            }

            .callbtn {
                background: #ffffff20;
                border: 1px solid #ffffff35;
                color: white;
                border-radius: 14px;
                padding: 12px 15px
            }

            .callbtn.active {
                background: #2b79db
            }

            .timer {
                font-variant-numeric: tabular-nums;
                margin-top: 9px;
                color: #c7d8ee
            }

            .transcript {
                width: 100%;
                text-align: left;
                background: #ffffff13;
                border: 1px solid #ffffff25;
                padding: 16px;
                border-radius: 18px;
                margin-top: 18px;
                min-height: 130px;
                max-height: 185px;
                overflow: auto;
                font-size: 14px;
                line-height: 1.6
            }

            .bubble {
                margin-bottom: 10px
            }

            .bubble b {
                color: #9dd4ff
            }

            .bubble.user b {
                color: #aaf1ca
            }

            .tools {
                display: flex;
                gap: 8px;
                flex-wrap: wrap;
                justify-content: center;
                margin: 12px 0
            }

            .panel {
                background: white;
                border: 1px solid #e3ebf5;
                border-radius: 22px;
                padding: 23px;
                box-shadow: 0 8px 28px #28456a0c;
                margin-bottom: 18px
            }

            .panel h2 {
                font-size: 19px;
                margin: 0 0 15px
            }

            .panel p {
                font-size: 14px;
                color: #6a7d93;
                line-height: 1.7
            }

            .primary {
                background: #286fe0;
                color: white;
                border: 0;
                padding: 13px 19px;
                border-radius: 12px;
                font-weight: 700
            }

            .secondary {
                background: #eaf2ff;
                color: #245fbb;
                border: 0;
                padding: 12px 15px;
                border-radius: 12px;
                font-weight: 700
            }

            .metrics {
                display: grid;
                grid-template-columns: repeat(3,1fr);
                gap: 10px
            }

            .metric {
                background: #f3f7fc;
                border-radius: 15px;
                padding: 16px
            }

            .metric small {
                display: block;
                color: #6a7d93;
                margin-bottom: 8px
            }

            .metric strong {
                font-size: 23px
            }

            .risk {
                color: #18845e
            }

            .warning {
                color: #cf781a
            }

            .danger {
                color: #df4557
            }

            .log {
                padding: 0;
                list-style: none;
                max-height: 250px;
                overflow: auto
            }

            .log li {
                padding: 12px 0;
                border-bottom: 1px solid #edf1f6;
                font-size: 14px;
                line-height: 1.5
            }

            .log li small {
                display: block;
                color: #8a99ab
            }

            .notice {
                font-size: 12px;
                color: #76889e;
                line-height: 1.7
            }

            .alert {
                background: #fff2f0;
                border: 1px solid #ffc9c1;
                color: #ad302b;
                border-radius: 12px;
                padding: 13px;
                font-size: 14px;
                margin-top: 12px
            }

            .inputline {
                display: flex;
                gap: 8px
            }

            .inputline input {
                min-width: 0;
                flex: 1;
                border: 1px solid #d8e2ef;
                border-radius: 12px;
                padding: 12px;
                font: inherit
            }

            .inputline button {
                flex-shrink: 0
            }

            @media(max-width: 800px) {
                .layout {
                    grid-template-columns:1fr
                }

                .phone {
                    max-width: 410px;
                    width: 100%;
                    margin: auto
                }

                .metrics {
                    grid-template-columns: repeat(3,1fr)
                }
            }

            @media(max-width: 420px) {
                .shell {
                    padding:16px 12px 50px
                }

                .panel {
                    padding: 17px
                }

                .metric {
                    padding: 10px
                }

                .metric strong {
                    font-size: 19px
                }
            }
        </style>
    </head>
    <body>
        <main class="shell">
            <header class="top">
                <div class="brand">
                    💙 안심<span>온</span>
                    <small style="font-size:12px;font-weight:500">AI Care</small>
                </div>
                <div class="tag">경진대회 시연용 MVP</div>
            </header>
            <section class="hero">
                <h1>
                    전화 한 통으로 시작하는<br>매일의 안심
                </h1>
                <p>어르신은 전화를 받기만 하면 됩니다. AI가 안부를 묻고, 돌봄 담당자는 결과를 확인합니다.</p>
            </section>
            <div class="layout">
                <section class="phone">
                    <div class="status">9:41 ▰ ▰ ▰</div>
                    <div class="callinfo">
                        <div class="small" id="stateLabel">수신 전화 · 시연 모드</div>
                        <div class="caller">안심온 돌봄전화</div>
                        <div class="sub" id="callSub">오늘도 건강한 하루 보내세요</div>
                        <div class="timer" id="timer"></div>
                    </div>
                    <div id="idleAvatar" class="avatar">💙</div>
                    <div id="transcript" class="transcript" hidden aria-live="polite"></div>
                    <div id="tools" class="tools" hidden>
                        <button class="callbtn" id="micBtn">🎙️ 말하기</button>
                        <button class="callbtn" id="soundBtn">🔊 음성 켜짐</button>
                    </div>
                    <div class="actions" id="incoming">
                        <div>
                            <button class="circle red" id="reject" aria-label="거절">✕</button>
                            <div class="actionlabel">거절</div>
                        </div>
                        <div>
                            <button class="circle green" id="accept" aria-label="수신">☎</button>
                            <div class="actionlabel">수신</div>
                        </div>
                    </div>
                    <div class="actions" id="ongoing" hidden>
                        <div>
                            <button class="circle red" id="hangup" aria-label="통화 종료">✕</button>
                            <div class="actionlabel">통화 종료</div>
                        </div>
                    </div>
                    <div class="actions" id="finished" hidden>
                        <button class="callbtn" id="restart">↻ 다시 전화 받기</button>
                    </div>
                </section>
                <aside>
                    <section class="panel">
                        <h2>📊 생활지원사 안부 확인</h2>
                        <p>AI 안부전화의 진행 상황과 어르신의 답변을 간단하게 확인합니다. 의료 진단이나 응급 자동 신고 기능은 없습니다.</p>
                        <div class="metrics">
                            <div class="metric"><small>통화 상태</small><strong id="callStatus">대기</strong></div>
                            <div class="metric"><small>답변 수</small><strong id="answerCount">0 / 5</strong></div>
                            <div class="metric"><small>확인 결과</small><strong id="checkResult">미확인</strong></div>
                        </div>
                        <div style="margin-top:16px"><strong>이번 통화 요약</strong><p id="summary">통화 후 요약이 표시됩니다.</p></div>
                    </section>
                    <section class="panel">
                        <h2>💬 대화 시뮬레이터</h2>
                        <p>말하기 버튼으로 답변하거나 아래 입력창을 이용할 수 있습니다. 마이크가 지원되지 않는 브라우저에서는 텍스트로 시연하세요.</p>
                        <div class="inputline">
                            <input id="answer" placeholder="예: 아침은 먹었는데 잠을 못 잤어" aria-label="어르신 답변" disabled>
                            <button class="primary" id="send" disabled>전송</button>
                        </div>
                        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px">
                            <button class="secondary sample" data-msg="아침도 먹고 약도 잘 챙겨 먹었어">식사 답변</button>
                            <button class="secondary sample" data-msg="어제 잠을 못 자고 밥도 못 먹었어">수면 답변</button>
                            <button class="secondary sample" data-msg="오늘은 몸이 조금 피곤해요">몸 상태 답변</button>
                        </div>
                    </section>
                    <section class="panel">
                        <h2>🗂️ 통화 기록</h2>
                        <ul class="log" id="history">
                            <li>아직 통화 기록이 없습니다.</li>
                        </ul>
                        <button class="secondary" id="clear">기록 지우기</button>
                    </section>
                    <p class="notice">⚠️ 본 서비스는 발표·시연용 프로토타입입니다. 실제 전화망 발신, 의료적 진단, 실시간 119 신고 및 출동 연계 기능은 포함되지 않습니다. 긴급 상황에서는 즉시 119에 직접 연락하세요. 대화 요약은 이 브라우저에 저장됩니다. 실제 개인정보를 입력하지 마세요.</p>
                </aside>
            </div>
        </main>
        <script>
        const $ = id => document.getElementById(id);
        const prompts = [
          '안녕하세요, 안심온입니다. 오늘 몸은 좀 어떠세요?',
          '오늘 식사는 잘 챙겨 드셨나요?',
          '어젯밤 잠은 편히 주무셨나요?',
          '드시는 약은 잘 챙겨 드셨나요?',
          '오늘 기분은 어떠세요? 불편한 곳은 없으세요?'
        ];
        const storageKey = 'ansimon_records_v2';
        let active = false, finished = false, step = 0, seconds = 0, tick = null;
        let recognition = null, sound = true, turns = [], answers = [];
        function speak(text, done) {
          if (!sound || !('speechSynthesis' in window)) { if(done) done(); return; }
          speechSynthesis.cancel();
          const u = new SpeechSynthesisUtterance(text);
          u.lang = 'ko-KR'; u.rate = 0.88;
          u.onend = () => { if(done && active) done(); };
          u.onerror = () => { if(done && active) done(); };
          speechSynthesis.speak(u);
        }
        function add(who, msg) {
          turns.push({who, msg});
          const d = document.createElement('div');
          d.className = 'bubble ' + (who === '어르신' ? 'user' : '');
          const b = document.createElement('b'); b.textContent = who + ' · ';
          d.append(b, document.createTextNode(msg));
          $('transcript').append(d);
          $('transcript').scrollTop = $('transcript').scrollHeight;
        }
        function ask(text, done) { add('안심온', text); speak(text, done); }
        function updateStatus(status) {
          $('callStatus').textContent = status;
          $('answerCount').textContent = answers.length + ' / 5';
        }
        function makeSummary() {
          if (!answers.length) return '답변 없이 통화가 종료되었습니다.';
          const labels = ['몸 상태', '식사', '수면', '복약', '기분'];
          return answers.map((answer, i) => labels[i] + ': ' + answer).join(' / ');
        }
        function submit(value) {
          const text = value.trim();
          if (!active || finished || !text || step >= prompts.length) return;
          if (recognition) { try { recognition.abort(); } catch(e) {} recognition = null; }
          if ('speechSynthesis' in window) speechSynthesis.cancel();
          add('어르신', text); answers.push(text); $('answer').value = '';
          updateStatus('통화 중');
          step++;
          if (step < prompts.length) ask(prompts[step]);
          else {
            finished = true;
            $('answer').disabled = true; $('send').disabled = true; $('micBtn').disabled = true;
            ask('말씀해 주셔서 감사합니다. 오늘도 건강하고 편안한 하루 보내세요. 안심온이었습니다.', () => end());
            // 음성 합성이 지원되지 않거나 꺼져 있어도 정상 종료
            if (!sound || !('speechSynthesis' in window)) end();
            $('callSub').textContent = '안부 확인 완료 · 통화 종료 버튼을 눌러도 됩니다';
          }
        }
        function start() {
          active = true; finished = false; step = 0; seconds = 0; turns = []; answers = [];
          $('summary').textContent = '통화가 진행 중입니다.';
          $('checkResult').textContent = '진행 중'; updateStatus('통화 중');
          $('transcript').replaceChildren(); $('transcript').hidden = false;
          $('idleAvatar').hidden = true; $('incoming').hidden = true;
          $('finished').hidden = true; $('ongoing').hidden = false; $('tools').hidden = false;
          $('answer').disabled = false; $('send').disabled = false; $('micBtn').disabled = false;
          $('stateLabel').textContent = 'AI 안부 확인 통화 중';
          $('callSub').textContent = '편안하게 말씀해 주세요';
          $('timer').textContent = '00:00';
          clearInterval(tick);
          tick = setInterval(() => {
            seconds++;
            $('timer').textContent = String(Math.floor(seconds / 60)).padStart(2,'0') + ':' + String(seconds % 60).padStart(2,'0');
          }, 1000);
          ask(prompts[0]);
        }
        function getRecords() {
          try { return JSON.parse(localStorage.getItem(storageKey) || '[]'); }
          catch(e) { return []; }
        }
        function saveRecord(record) {
          try { localStorage.setItem(storageKey, JSON.stringify([record, ...getRecords()].slice(0, 15))); }
          catch(e) { alert('브라우저 저장 공간을 사용할 수 없어 기록을 저장하지 못했습니다.'); }
          renderHistory();
        }
        function end(rejected = false) {
          if (!active && !rejected) return;
          const wasActive = active;
          active = false; clearInterval(tick);
          if (recognition) { try { recognition.abort(); } catch(e) {} recognition = null; }
          if ('speechSynthesis' in window) speechSynthesis.cancel();
          $('incoming').hidden = true; $('ongoing').hidden = true;
          $('finished').hidden = false; $('tools').hidden = true;
          $('answer').disabled = true; $('send').disabled = true;
          const status = rejected ? '수신 거절' : answers.length === prompts.length ? '안부 확인 완료' : '통화 중단';
          const summary = rejected ? '전화를 받지 않았습니다.' : makeSummary();
          $('stateLabel').textContent = status;
          $('callSub').textContent = '돌봄 기록이 업데이트되었습니다';
          $('checkResult').textContent = status;
          $('summary').textContent = summary;
          updateStatus(status);
          if (wasActive || rejected) saveRecord({date: new Date().toLocaleString('ko-KR'), status, summary, turns: turns.slice()});
        }
        function renderHistory() {
          const list = $('history'); list.replaceChildren();
          const records = getRecords();
          if (!records.length) { const li = document.createElement('li'); li.textContent = '아직 통화 기록이 없습니다.'; list.append(li); return; }
          records.forEach(record => {
            const li = document.createElement('li');
            const title = document.createElement('b'); title.textContent = record.status;
            const date = document.createElement('small'); date.textContent = record.date;
            const detail = document.createElement('div'); detail.textContent = record.summary;
            li.append(title, date, detail); list.append(li);
          });
        }
        $('accept').onclick = start;
        $('reject').onclick = () => end(true);
        $('hangup').onclick = () => end();
        $('restart').onclick = () => {
          $('finished').hidden = true; $('incoming').hidden = false;
          $('transcript').hidden = true; $('idleAvatar').hidden = false;
          $('stateLabel').textContent = '수신 전화 · 시연 모드';
          $('callSub').textContent = '오늘도 건강한 하루 보내세요'; $('timer').textContent = '';
          $('callStatus').textContent = '대기'; $('checkResult').textContent = '미확인';
          $('answerCount').textContent = '0 / 5'; $('summary').textContent = '통화 후 요약이 표시됩니다.';
        };
        $('send').onclick = () => submit($('answer').value);
        $('answer').onkeydown = e => { if (e.key === 'Enter') submit($('answer').value); };
        document.querySelectorAll('.sample').forEach(button => button.onclick = () => {
          if (!active) { alert('먼저 전화를 받아 주세요.'); return; }
          submit(button.dataset.msg);
        });
        $('soundBtn').onclick = () => {
          sound = !sound;
          $('soundBtn').textContent = sound ? '🔊 음성 켜짐' : '🔇 음성 꺼짐';
          if (!sound && 'speechSynthesis' in window) speechSynthesis.cancel();
          if (!sound && active && finished) end();
        };
        $('micBtn').onclick = () => {
          if (!active || finished) return;
          const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
          if (!SR) { alert('이 브라우저에서는 음성 인식을 지원하지 않습니다. 텍스트로 답변해 주세요.'); return; }
          if (recognition) { try { recognition.stop(); } catch(e) {} return; }
          if ('speechSynthesis' in window) speechSynthesis.cancel();
          const instance = new SR(); recognition = instance;
          instance.lang = 'ko-KR'; instance.interimResults = false; instance.maxAlternatives = 1;
          instance.onresult = e => submit(e.results[0][0].transcript);
          instance.onerror = e => {
            if (e.error !== 'aborted') alert('음성 인식 오류: ' + e.error + '. 텍스트 입력도 가능합니다.');
          };
          instance.onend = () => { if (recognition === instance) recognition = null; $('micBtn').textContent = '🎙️ 말하기'; };
          try { instance.start(); $('micBtn').textContent = '🔴 듣는 중'; }
          catch(e) { recognition = null; alert('마이크를 시작하지 못했습니다.'); }
        };
        $('clear').onclick = () => {
          if (confirm('시연 통화 기록을 모두 지울까요?')) { localStorage.removeItem(storageKey); renderHistory(); }
        };
        renderHistory();
        </script>
    </body>
</html>
